# ─── BASE DE DATOS ───────────────────────────────────────────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://postgres:TU_CONTRASEÑA@localhost:5432/gestar_erp"

# ─── AUTENTICACIÓN ───────────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres"

# ─── SERVIDOR ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production          # development | production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Origen permitido para el frontend. Usa '*' solo en desarrollo.
CORS_ORIGIN="https://tu-dominio.com"

# ─── ASISTENTE IA ─────────────────────────────────────────────────────────────
# Obtén tu API key en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# ─── EMAIL / SMTP (Resend) ────────────────────────────────────────────────────
# Sin estas variables los emails se imprimen en consola (modo desarrollo).
# Producción usa Resend: el usuario SIEMPRE es "resend" y la contraseña es la API key.
# Crea la API key en https://resend.com/api-keys y verifica tu dominio en https://resend.com/domains
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS="re_tu_api_key_de_resend"
EMAIL_FROM="GESTAR ERP <noreply@gestarsoft.com>"

# ─── ADMINISTRACIÓN ──────────────────────────────────────────────────────────
# Clave secreta para el endpoint admin (extender trials, ver empresas)
# Genera una con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET="cambia_esto_por_una_clave_secreta"

# ─── FRONTEND ─────────────────────────────────────────────────────────────────
# URL pública del frontend (para links en emails de recuperación de contraseña)
FRONTEND_URL="https://app.gestarsoft.com"

# ─── ALMACENAMIENTO DE ADJUNTOS (Cloudflare R2) ───────────────────────────────
# OPCIONAL. Si defines las 4 variables, los adjuntos (facturas/órdenes) se suben
# a Cloudflare R2 en lugar de guardarse como binario en Postgres.
# Sin estas variables, los adjuntos se guardan en la base de datos (modo por defecto).
# Crea bucket + API token en: Cloudflare Dashboard → R2
R2_ACCOUNT_ID=""             # ID de cuenta de Cloudflare
R2_ACCESS_KEY_ID=""          # Access Key ID del token R2
R2_SECRET_ACCESS_KEY=""      # Secret Access Key del token R2
R2_BUCKET=""                 # nombre del bucket, ej: gestar-erp-adjuntos

# ─── PAGOS / PAYPAL ───────────────────────────────────────────────────────────
# Credenciales de la app PayPal (modo live para producción).
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="live"           # live | sandbox
PAYPAL_WEBHOOK_ID=""
# Plan IDs generados por scripts/setup-planes-erp.mjs (mensuales)
PAYPAL_PLAN_ID_EMPRENDE=""
PAYPAL_PLAN_ID_BASICO=""
PAYPAL_PLAN_ID_PROFESIONAL=""
PAYPAL_PLAN_ID_DESPACHO=""
PAYPAL_PLAN_ID_ENTERPRISE=""
# Planes anuales (2 meses gratis)
PAYPAL_PLAN_ID_EMPRENDE_ANUAL=""
PAYPAL_PLAN_ID_BASICO_ANUAL=""
PAYPAL_PLAN_ID_PROFESIONAL_ANUAL=""
PAYPAL_PLAN_ID_DESPACHO_ANUAL=""
PAYPAL_PLAN_ID_ENTERPRISE_ANUAL=""
# Planes Fundador (precio de por vida, mostrados en la landing)
PAYPAL_PLAN_ID_FUNDADOR_DESPACHO=""
PAYPAL_PLAN_ID_FUNDADOR_ENTERPRISE=""
