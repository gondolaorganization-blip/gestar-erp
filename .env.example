# ─── BASE DE DATOS ───────────────────────────────────────────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://postgres:TU_CONTRASEÑA@localhost:5432/gestar_erp"

# ─── AUTENTICACIÓN ───────────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres"

# ─── SERVIDOR ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production          # development | production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Origen permitido para el frontend. Usa '*' solo en desarrollo.
CORS_ORIGIN="https://tu-dominio.com"

# ─── ASISTENTE IA ─────────────────────────────────────────────────────────────
# Obtén tu API key en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# ─── EMAIL / SMTP ─────────────────────────────────────────────────────────────
# Sin estas variables los emails se imprimen en consola (modo desarrollo)
# Compatible con Gmail, Mailgun, SendGrid, Resend, etc.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu@gmail.com"
SMTP_PASS="tu_app_password"
EMAIL_FROM="GESTAR ERP <noreply@tudominio.com>"

# ─── ADMINISTRACIÓN ──────────────────────────────────────────────────────────
# Clave secreta para el endpoint admin (extender trials, ver empresas)
# Genera una con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET="cambia_esto_por_una_clave_secreta"

# ─── FRONTEND ─────────────────────────────────────────────────────────────────
# URL pública del frontend (para links en emails de recuperación de contraseña)
FRONTEND_URL="https://app.gestar-erp.com"
